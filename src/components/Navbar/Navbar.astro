<nav
  id="navbar"
  class="col-span-12 fixed top-0 left-0 w-full bg-white shadow-md opacity-0 transition-opacity duration-500 z-50"
>
  <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
    <h1 class="text-xl font-bold">Andreas Klumpp</h1>
    <ul class="flex space-x-4">
      <li><a href="/" class="hover:text-blue-500">Home</a></li>
      <li><a href="/about-me" class="hover:text-blue-500">About me</a></li>
      <li><a href="/blog" class="hover:text-blue-500">Blog</a></li>
    </ul>
  </div>
</nav>

<script>
  window.addEventListener("scroll", () => {
    const nav = document.getElementById("navbar");

    if (nav === null) {
      return;
    }

    if (window.scrollY > 100) {
      nav.classList.add("opacity-100");
    } else {
      nav.classList.remove("opacity-100");
    }
  });
</script>

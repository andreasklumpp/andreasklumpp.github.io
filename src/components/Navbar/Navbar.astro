---
const { currentPath } = Astro.props;
---
<nav
  id="navbar"
  class="fixed opacity-0 top-4 left-1/2 transform -translate-x-1/2 w-[95vw] max-w-5xl bg-white/70 backdrop-blur-md border border-gray-200/60 rounded-full shadow-md px-6 py-3 flex justify-center items-center transition-opacity duration-500 z-50"
>
  <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
    <ul class="flex space-x-4">
      <li><a href="/" class={`hover:text-blue-500 ${currentPath === '/' ? 'font-bold' : ''}`}>Home</a></li>
      <li><a href="/about-me" class={`hover:text-blue-500 ${currentPath.startsWith('/about-me') ? 'font-bold' : ''}`}>About me</a></li>
      <li><a href="/blog" class={`hover:text-blue-500 ${currentPath.startsWith('/blog') ? 'font-bold' : ''}`}>Blog</a></li>
    </ul>
  </div>
</nav>

<script>
  window.addEventListener("scroll", () => {
    const nav = document.getElementById("navbar");

    if (nav === null) {
      return;
    }

    if (window.scrollY > 100) {
      nav.classList.add("opacity-100");
    } else {
      nav.classList.remove("opacity-100");
    }
  });
</script>


---

<section class="col-span-12 grid grid-cols-12 min-h-screen">
  <!-- Image Section -->
  <div class="col-span-8 relative">
    <img
      src="../../../public/Hero_Andreas_Klumpp.jpg"
      alt="Hero Image"
      class="w-full h-full object-cover clip-hero"
    />
  </div>

  <!-- Text Section -->
  <div class="col-span-4 flex items-center px-6">
    <div>
      <h1 class="font-bebasNeue text-white text-8xl font-bold mb-4">
        Andreas Klumpp
      </h1>

      <a
        href="/about-me"
        class="font-roboto text-white text-2xl mb-4 hover:underline hover:decoration-dotted hover:underline-offset-2"
        >About me</a
      >
      <!-- <p class="text-lg text-gray-600">-> Learn more about me</p> -->
    </div>
  </div>
</section>

<style>
  .clip-hero {
    clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
  }
</style>

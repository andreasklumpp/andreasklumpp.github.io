---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  // @ts-ignore – CollectionEntry types resolve after `astro sync`
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(dateInput: string | Date) {
  if (!dateInput) return "";
  const date = typeof dateInput === "string" ? new Date(dateInput) : dateInput;
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout title={`${post.data.title} — Andreas Klumpp`}>
  <main class="post-main">
    <div class="post-header">
      <a href="/blog" class="back-link">← All posts</a>

      <div class="post-meta">
        <div class="post-tags">
          {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
        <span class="post-date">{formatDate(post.data.date)}</span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-excerpt">{post.data.excerpt}</p>
    </div>

    <div class="post-divider"></div>

    <article class="prose">
      <Content />
    </article>

    <div class="post-footer">
      <a href="/blog" class="back-link">← All posts</a>
    </div>
  </main>
</Layout>

<style>
  .post-main {
    min-height: 100svh;
    padding: 7rem 3rem 6rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .post-header {
    padding-bottom: 3rem;
    position: relative;
  }

  .post-header::before {
    content: '';
    position: absolute;
    width: 700px;
    height: 500px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.15), transparent 70%);
    filter: blur(100px);
    top: -40%;
    right: -20%;
    pointer-events: none;
    z-index: 0;
  }

  .post-header > * {
    position: relative;
    z-index: 1;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
    display: inline-block;
    margin-bottom: 2.5rem;
  }

  .back-link:hover {
    color: var(--fg);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--green);
    border: 1px solid #1f3010;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--fg);
    margin-bottom: 1.25rem;
  }

  .post-excerpt {
    font-size: 1rem;
    color: var(--muted);
    font-weight: 300;
    line-height: 1.7;
  }

  .post-divider {
    height: 1px;
    background: linear-gradient(90deg, #7c3aed, #db2777, #a3ff4f, transparent);
    margin: 3rem 0;
    opacity: 0.5;
  }

  .post-footer {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .post-main { padding: 6rem 1.5rem 4rem; }
  }
</style>

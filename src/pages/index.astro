---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero/Hero.astro";
import Navbar from "../components/Navbar/Navbar.astro";

const allPosts = await getCollection("blog");

function formatDate(dateStr: string) {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}
---

<Layout title="Andreas Klumpp Homepage">
  <Navbar currentPath="/" />
  <Hero />

  <section class="contents max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
    <div class="col-span-12">
      <h2
        class="text-4xl font-extrabold tracking-tight text-gray-900 mb-2 text-center"
      >
        From the blog
      </h2>
      <p class="text-xl text-gray-500 mb-8 px-12 text-center">
        Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy
        eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam
        voluptua. At
      </p>
    </div>


      {
        allPosts.map((post) => (
          <div class="col-span-12 md:col-start-4 md:col-span-6">
            <div class="bg-white/80 backdrop-blur-md border border-gray-200/60 rounded-xl p-8 shadow-sm">
              <span class="text-sm text-gray-400 block mb-2">{formatDate(String(post.data.date)) || "Mar 16, 2020"}</span>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{post.data.title}</h3>
              <p class="text-base text-gray-500">{post.data.excerpt}</p>
            </div>
          </div>
        ))
      }

  </section>
</Layout>

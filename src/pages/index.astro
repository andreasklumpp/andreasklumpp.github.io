---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

type Post = { slug: string; data: { title: string; excerpt: string; date: string | Date; tags: string[] } };

const allPosts = (await getCollection("blog")) as Post[];
const recentPosts = allPosts
  .sort((a: Post, b: Post) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function formatDate(dateInput: string | Date) {
  if (!dateInput) return "";
  const date = typeof dateInput === "string" ? new Date(dateInput) : dateInput;
  return date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
}
---


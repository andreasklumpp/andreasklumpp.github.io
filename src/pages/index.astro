<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
  tl.from(".hero-tag", { opacity: 0, y: -16, duration: 0.6, delay: 0.2 })
    .from(".hero-eyebrow", { opacity: 0, y: 24, duration: 0.8 }, "-=0.3")
    .from(".name-filled", { opacity: 0, y: 80, duration: 0.9 }, "-=0.4")
    .from(".name-outline", { opacity: 0, y: 80, duration: 0.9 }, "-=0.75")
    .from(".hero-desc", { opacity: 0, y: 20, duration: 0.6 }, "-=0.3")
    .from(".hero-cta", { opacity: 0, y: 20, duration: 0.6 }, "-=0.4")
    .from(".hero-footer", { opacity: 0, duration: 0.5 }, "-=0.2")
    .from(".orb", { opacity: 0, scale: 0.6, duration: 1.5, stagger: 0.15, ease: "power2.out" }, 0);

  gsap.from(".marquee-wrap", {
    scrollTrigger: { trigger: ".marquee-wrap", start: "top 90%" },
    opacity: 0,
    duration: 0.6,
    ease: "power2.out",
  });

  gsap.from(".section-header", {
    scrollTrigger: { trigger: "#about", start: "top 78%" },
    opacity: 0,
    y: 40,
    duration: 0.8,
    ease: "power3.out",
  });

  gsap.from(".about-bio", {
    scrollTrigger: { trigger: ".about-grid", start: "top 75%" },
    opacity: 0,
    x: -40,
    duration: 0.8,
    ease: "power3.out",
  });

  gsap.from(".about-sidebar", {
    scrollTrigger: { trigger: ".about-grid", start: "top 75%" },
    opacity: 0,
    x: 40,
    duration: 0.8,
    delay: 0.15,
    ease: "power3.out",
  });

  gsap.from(".post-row", {
    scrollTrigger: { trigger: ".posts-list", start: "top 82%" },
    opacity: 0,
    y: 24,
    duration: 0.5,
    stagger: 0.1,
    ease: "power3.out",
  });
</script>

<style>
  /* ── HERO ── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7rem 3rem 3rem;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  /* gradient orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(130px);
    pointer-events: none;
    z-index: 0;
  }

  .orb-purple {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.35), transparent 70%);
    top: -15%;
    left: 50%;
    transform: translateX(-50%);
  }

  .orb-pink {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(219, 39, 119, 0.2), transparent 70%);
    top: 5%;
    right: -8%;
  }

  .orb-green {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(163, 255, 79, 0.12), transparent 70%);
    bottom: 10%;
    left: -5%;
  }

  /* all direct children above orbs */
  .hero-meta,
  .hero-content,
  .hero-footer {
    position: relative;
    z-index: 1;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    animation: pulse 2.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-year {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  /* centered content block */
  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 0 2rem;
    gap: 0;
  }

  .hero-eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 400;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin-bottom: 2.5rem;
  }

  .name-line {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 14rem);
    display: block;
  }

  .name-filled {
    color: var(--fg);
  }

  .name-outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--fg);
    transition: -webkit-text-stroke-color 0.3s;
  }

  .name-outline:hover {
    -webkit-text-stroke-color: var(--green);
  }

  .hero-desc {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--muted);
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--fg);
    color: #000;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    border-radius: 100px;
    transition: background 0.2s, transform 0.2s;
  }

  .btn-hero-primary:hover {
    background: var(--green);
    transform: translateY(-2px);
  }

  .btn-arrow {
    transition: transform 0.2s;
  }

  .btn-hero-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(255,255,255,0.15);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    border-radius: 100px;
    transition: border-color 0.2s, color 0.2s;
    backdrop-filter: blur(8px);
  }

  .btn-hero-ghost:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  /* hero footer row */
  .hero-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .scroll-line-wrap {
    width: 1px;
    height: 48px;
    background: var(--border);
    overflow: hidden;
  }

  .scroll-line-inner {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--fg);
    animation: scrollDown 1.8s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }

  .scroll-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-socials {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .hero-socials a {
    transition: color 0.2s;
  }

  .hero-socials a:hover {
    color: var(--fg);
  }

  /* ── MARQUEE ── */
  .marquee-wrap {
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0;
    background: #0f0f0f;
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .marquee-item {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding: 0 0.5rem;
    white-space: nowrap;
  }

  .marquee-dot {
    color: var(--green);
    padding: 0 0.5rem;
    font-size: 1.1rem;
  }

  /* ── SECTION SHARED ── */
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4rem;
  }

  .section-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin-top: 0.5rem;
    background: linear-gradient(135deg, #7c3aed, #a3ff4f);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--fg);
  }

  /* ── ABOUT ── */
  .about-section {
    padding: 6rem 3rem;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .about-section::before {
    content: '';
    position: absolute;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.13), transparent 70%);

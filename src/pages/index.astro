    position: relative;
    z-index: 1;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .bio-para {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .bio-langs {

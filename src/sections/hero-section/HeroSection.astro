---
import heroImage from "../../images/AK.png";

// No props for now
---

<section
  class="col-span-12 grid grid-cols-12 min-h-screen items-center relative h-100vh"
>
  <!-- Text Section -->
  <div class="col-span-6 flex items-center px-6 h-[100vh]">
    <div class="mb-20">
      <h1 class="font-roboto text-black text-7xl font-bold mb-4">
        Hey! 👋 <br />I'm Andreas!
      </h1>
      <div class="flex mt-8 flex-col">
        <a
          href="/blog"
          class="font-roboto text-xl text-black font-semibold underline underline-offset-4 hover:text-gray-800 transition-colors duration-200 flex items-center group mb-2"
          style="text-decoration-style: dotted;"
        >
          My blog
          <svg
            class="ml-2 w-4 h-4 text-black group-hover:text-gray-800 transition-colors duration-200 transform -rotate-45"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>

        <a
          href="https://github.com/andreasklumpp"
          target="_blank"
          rel="noopener noreferrer"
          class="font-roboto text-xl text-black font-semibold underline underline-offset-4 hover:text-gray-800 transition-colors duration-200 flex items-center group"
          style="text-decoration-style: dotted;"
        >
          My Github
          <svg
            class="ml-2 w-4 h-4 text-black group-hover:text-gray-800 transition-colors duration-200 transform -rotate-45"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Image Section -->
  <div class="col-span-6 relative h-[100vh] flex items-center justify-center">
    <img
      src={heroImage.src}
      alt="Hero Image"
      class="h-full w-auto max-w-none"
      style="mask-image: linear-gradient(to bottom, white 50%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, white 70%, transparent 100%);"
    />
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Register ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);
  // Wait for the DOM to be fully loaded
  const elements = document.querySelectorAll(".animate-line-height");

  elements.forEach((element) => {
    gsap.fromTo(
      element,
      { lineHeight: 1 },
      {
        lineHeight: "2",
        ease: "none",
        scrollTrigger: {
          trigger: element,
          // start: "100",
          end: "top",
          scrub: true, // This makes the animation smooth while scrolling
          // markers: true, // Uncomment this for debugging
        },
      }
    );
  });
</script>

<style>
  .animate-line-height {
    transition: line-height 0.1s ease;
  }

  .clip-hero {
    clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
  }

  .scroll-indicator {
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-bounce {
    animation: bounce 2s infinite;
  }
</style>
